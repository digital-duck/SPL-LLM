{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "SPL",
    "scopeName": "source.spl",
    "patterns": [
        { "include": "#comments" },
        { "include": "#fstrings" },
        { "include": "#strings" },
        { "include": "#constants" },
        { "include": "#variables" },
        { "include": "#exception_types" },
        { "include": "#types" },
        { "include": "#keywords" },
        { "include": "#function_calls" },
        { "include": "#numbers" },
        { "include": "#operators" },
        { "include": "#function_body" }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-dash.spl",
                    "match": "--.*$"
                },
                {
                    "name": "comment.line.number-sign.spl",
                    "match": "#.*$"
                },
                {
                    "name": "comment.block.spl",
                    "begin": "/\\*",
                    "end": "\\*/"
                }
            ]
        },
        "fstrings": {
            "patterns": [
                {
                    "comment": "SPL 2.0 triple-quoted f-string: f\"\"\"...\"\"\"",
                    "name": "string.quoted.triple.fstring.spl",
                    "begin": "[fF]\"\"\"",
                    "end": "\"\"\"",
                    "patterns": [
                        {
                            "match": "\\{(@[a-zA-Z_][a-zA-Z0-9_]*)\\}",
                            "captures": { "1": { "name": "variable.other.spl" } }
                        },
                        { "name": "constant.character.escape.spl", "match": "\\\\." }
                    ]
                },
                {
                    "comment": "SPL 2.0 f-string with double quotes: f\"...\"",
                    "name": "string.quoted.double.fstring.spl",
                    "begin": "[fF]\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "match": "\\{(@[a-zA-Z_][a-zA-Z0-9_]*)\\}",
                            "captures": { "1": { "name": "variable.other.spl" } }
                        },
                        { "name": "constant.character.escape.spl", "match": "\\\\." }
                    ]
                },
                {
                    "comment": "SPL 2.0 f-string with single quotes: f'...'",
                    "name": "string.quoted.single.fstring.spl",
                    "begin": "[fF]'",
                    "end": "'",
                    "patterns": [
                        {
                            "match": "\\{(@[a-zA-Z_][a-zA-Z0-9_]*)\\}",
                            "captures": { "1": { "name": "variable.other.spl" } }
                        },
                        { "name": "constant.character.escape.spl", "match": "\\\\." }
                    ]
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "comment": "Triple-quoted double string",
                    "name": "string.quoted.triple.double.spl",
                    "begin": "\"\"\"",
                    "end": "\"\"\"",
                    "patterns": [
                        { "name": "constant.character.escape.spl", "match": "\\\\." }
                    ]
                },
                {
                    "comment": "Triple-quoted single string",
                    "name": "string.quoted.triple.single.spl",
                    "begin": "'''",
                    "end": "'''",
                    "patterns": [
                        { "name": "constant.character.escape.spl", "match": "\\\\." }
                    ]
                },
                {
                    "name": "string.quoted.double.spl",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        { "name": "constant.character.escape.spl", "match": "\\\\." }
                    ]
                },
                {
                    "name": "string.quoted.single.spl",
                    "begin": "'",
                    "end": "'",
                    "patterns": [
                        { "name": "constant.character.escape.spl", "match": "\\\\." }
                    ]
                }
            ]
        },
        "constants": {
            "patterns": [
                {
                    "comment": "Boolean and null constants",
                    "name": "constant.language.spl",
                    "match": "(?i)\\b(TRUE|FALSE|NONE)\\b"
                }
            ]
        },
        "variables": {
            "patterns": [
                {
                    "comment": "SPL 2.0 variable references: @var_name",
                    "name": "variable.other.spl",
                    "match": "@[a-zA-Z_][a-zA-Z0-9_]*"
                },
                {
                    "comment": "memory.key and context.field dotted access",
                    "match": "\\b(memory|context)\\.([a-zA-Z_][a-zA-Z0-9_]*)",
                    "captures": {
                        "1": { "name": "support.variable.namespace.spl" },
                        "2": { "name": "variable.other.member.spl" }
                    }
                }
            ]
        },
        "exception_types": {
            "patterns": [
                {
                    "comment": "SPL 2.0 built-in CamelCase exception type names",
                    "name": "support.type.exception.spl",
                    "match": "\\b(HallucinationDetected|RefusalToAnswer|ContextLengthExceeded|ModelOverloaded|QualityBelowThreshold|MaxIterationsReached|BudgetExceeded|NodeUnavailable|GenerationError)\\b"
                },
                {
                    "comment": "SPL 2.0 exception category keywords",
                    "name": "support.type.exception.spl",
                    "match": "(?i)\\b(HALLUCINATION|REFUSAL|OVERFLOW|ITERATIONS|OTHERS)\\b"
                }
            ]
        },
        "types": {
            "patterns": [
                {
                    "comment": "SPL 2.0 data types used in INPUT/OUTPUT/RETURNS declarations",
                    "name": "support.type.spl",
                    "match": "(?i)\\b(TEXT|NUMBER|BOOLEAN|LIST|JSON|IMAGE)\\b"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "comment": "Top-level statement declarations",
                    "name": "keyword.declaration.spl",
                    "match": "(?i)\\b(PROMPT|WORKFLOW|PROCEDURE|IMPORT)\\b"
                },
                {
                    "comment": "CREATE FUNCTION / CREATE PROCEDURE",
                    "match": "(?i)\\b(CREATE)\\s+(FUNCTION|PROCEDURE)\\b",
                    "captures": {
                        "1": { "name": "keyword.declaration.spl" },
                        "2": { "name": "keyword.declaration.spl" }
                    }
                },
                {
                    "comment": "SPL 2.0 workflow control-flow keywords",
                    "name": "keyword.control.flow.spl",
                    "match": "(?i)\\b(DO|END|EVALUATE|WHEN|THEN|OTHERWISE|ELSE|WHILE|CALL|PARALLEL|COMMIT|ROLLBACK|BEGIN|RAISE|RETRY|EXCEPTION|INPUT|OUTPUT|INTO|RETURN|FOR)\\b"
                },
                {
                    "comment": "SELECT/FROM query clause keywords",
                    "name": "keyword.control.query.spl",
                    "match": "(?i)\\b(SELECT|FROM|AS|WHERE|ORDER\\s+BY|ASC|DESC|IN|AND|OR|NOT|LIMIT|RETURNS)\\b"
                },
                {
                    "comment": "GENERATE — core LLM invocation keyword",
                    "name": "keyword.other.generate.spl",
                    "match": "(?i)\\b(GENERATE|EXECUTE|EXPLAIN)\\b"
                },
                {
                    "comment": "STORE RESULT IN memory.<key>",
                    "match": "(?i)\\b(STORE)\\s+(RESULT)\\s+(IN)\\b",
                    "captures": {
                        "1": { "name": "keyword.other.spl" },
                        "2": { "name": "keyword.other.spl" },
                        "3": { "name": "keyword.other.spl" }
                    }
                },
                {
                    "comment": "WITH BUDGET <n> TOKENS",
                    "match": "(?i)\\b(WITH)\\s+(BUDGET)\\b",
                    "captures": {
                        "1": { "name": "keyword.other.spl" },
                        "2": { "name": "keyword.other.spl" }
                    }
                },
                {
                    "comment": "USING MODEL '<model>' — inline model override",
                    "begin": "(?i)\\b(USING)\\s+(MODEL)\\b",
                    "beginCaptures": {
                        "1": { "name": "keyword.other.spl" },
                        "2": { "name": "keyword.other.spl" }
                    },
                    "end": "(?i)(?=\\s*(;|WITH|CACHE|SELECT|GENERATE|STORE|$))",
                    "patterns": [
                        { "include": "#strings" },
                        {
                            "match": "\\b[a-zA-Z_][a-zA-Z0-9_.\\-]*\\b",
                            "name": "entity.name.type.model.spl"
                        }
                    ]
                },
                {
                    "comment": "LOGGING ... LEVEL keyword pair",
                    "match": "(?i)\\b(LOGGING)\\b",
                    "name": "keyword.other.spl"
                },
                {
                    "comment": "LEVEL <severity> after LOGGING",
                    "match": "(?i)\\b(LEVEL)\\s+(INFO|DEBUG|WARN|WARNING|ERROR|CRITICAL)\\b",
                    "captures": {
                        "1": { "name": "keyword.other.spl" },
                        "2": { "name": "support.constant.log-level.spl" }
                    }
                },
                {
                    "comment": "Transaction and error-handling keywords",
                    "name": "keyword.other.spl",
                    "match": "(?i)\\b(TRANSACTION|ON\\s+ERROR|ON|ERROR)\\b"
                },
                {
                    "comment": "Security / accounting policy keywords",
                    "name": "keyword.other.spl",
                    "match": "(?i)\\b(SECURITY|ACCOUNTING|CLASSIFICATION|LABELS)\\b"
                },
                {
                    "comment": "SPL 1.0 materialized view / storage keywords",
                    "name": "keyword.other.spl",
                    "match": "(?i)\\b(AUTO_COMPRESS|COMPRESSION_STRATEGY|SCHEMA|VERSION|REFRESH|EVERY|MATERIALIZED|GRID|VRAM)\\b"
                },
                {
                    "comment": "Token / output / configuration option keywords",
                    "name": "keyword.other.spl",
                    "match": "(?i)\\b(TOKENS|MODEL|CACHE|OUTPUT|TEMPERATURE|FORMAT|STORE|RESULT|PARAMS|WITH|BUDGET|RETURNS|USING|SET|DEFAULT|TO|LEVEL)\\b"
                }
            ]
        },
        "function_calls": {
            "patterns": [
                {
                    "comment": "SPL 2.0 built-in generation functions",
                    "match": "(?i)\\b(summarize|translate|classify|extract_entities|sentiment|answer|rewrite|generate_code|greeting|quality_judge|quality_check)(?=\\s*\\()",
                    "name": "support.function.builtin.spl"
                },
                {
                    "comment": "Context, memory, utility, and predicate functions",
                    "match": "(?i)\\b(system_role|rag|contains|length|upper|lower|trim|coalesce)(?=\\s*\\()",
                    "name": "support.function.builtin.spl"
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.spl",
                    "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "comment": "String concatenation operator ||",
                    "name": "keyword.operator.concatenation.spl",
                    "match": "\\|\\|"
                },
                {
                    "comment": "Pipe operator |",
                    "name": "keyword.operator.pipe.spl",
                    "match": "\\|"
                },
                {
                    "comment": "SPL 2.0 variable assignment :=",
                    "name": "keyword.operator.assignment.spl",
                    "match": ":="
                },
                {
                    "comment": "Comparison operators",
                    "name": "keyword.operator.comparison.spl",
                    "match": "(>=|<=|!=|<>|=|>|<)"
                },
                {
                    "comment": "Arithmetic operators",
                    "name": "keyword.operator.arithmetic.spl",
                    "match": "[+\\-*/%]"
                },
                {
                    "comment": "Statement terminator",
                    "name": "punctuation.terminator.statement.spl",
                    "match": ";"
                },
                {
                    "comment": "Colon separator",
                    "name": "punctuation.separator.colon.spl",
                    "match": ":"
                }
            ]
        },
        "function_body": {
            "comment": "CREATE FUNCTION body delimited by $$...$$",
            "begin": "\\$\\$",
            "end": "\\$\\$",
            "beginCaptures": { "0": { "name": "punctuation.definition.heredoc.spl" } },
            "endCaptures":   { "0": { "name": "punctuation.definition.heredoc.spl" } },
            "name": "meta.embedded.function-body.spl",
            "patterns": [
                { "include": "#comments" },
                { "include": "#fstrings" },
                { "include": "#strings" },
                { "include": "#constants" },
                { "include": "#variables" },
                { "include": "#keywords" },
                { "include": "#function_calls" },
                { "include": "#numbers" },
                { "include": "#operators" }
            ]
        }
    }
}
