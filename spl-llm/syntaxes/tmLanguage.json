{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "SPL",
    "scopeName": "source.spl",
    "patterns": [
        { "include": "#comments" },
        { "include": "#function_body" },
        { "include": "#fstrings" },
        { "include": "#strings" },
        { "include": "#constants" },
        { "include": "#variables" },
        { "include": "#exception_types" },
        { "include": "#types" },
        { "include": "#keywords" },
        { "include": "#function_calls" },
        { "include": "#numbers" },
        { "include": "#operators" }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-dash.spl",
                    "match": "--.*$"
                },
                {
                    "name": "comment.line.number-sign.spl",
                    "match": "#.*$"
                },
                {
                    "name": "comment.block.spl",
                    "begin": "/\\*",
                    "end": "\\*/"
                }
            ]
        },
        "function_body": {
            "comment": "CREATE FUNCTION prompt body delimited by $$ ... $$. Only {param} slots are highlighted inside — the body is natural language, not SPL.",
            "begin": "\\$\\$",
            "end": "\\$\\$",
            "beginCaptures": { "0": { "name": "punctuation.definition.heredoc.spl" } },
            "endCaptures":   { "0": { "name": "punctuation.definition.heredoc.spl" } },
            "name": "string.unquoted.heredoc.spl",
            "patterns": [
                {
                    "comment": "Template parameter slot {param} inside prompt body",
                    "match": "\\{([a-zA-Z_][a-zA-Z0-9_]*)\\}",
                    "captures": { "1": { "name": "variable.parameter.spl" } }
                },
                {
                    "comment": "SPL variable reference @var inside prompt body",
                    "name": "variable.other.spl",
                    "match": "@[a-zA-Z_][a-zA-Z0-9_]*"
                }
            ]
        },
        "fstrings": {
            "patterns": [
                {
                    "comment": "SPL f-string triple double-quoted: f\"\"\"...\"\"\"",
                    "name": "string.quoted.triple.fstring.spl",
                    "begin": "[fF]\"\"\"",
                    "end": "\"\"\"",
                    "patterns": [
                        {
                            "match": "\\{(@[a-zA-Z_][a-zA-Z0-9_]*)\\}",
                            "captures": { "1": { "name": "variable.other.spl" } }
                        },
                        { "name": "constant.character.escape.spl", "match": "\\\\." }
                    ]
                },
                {
                    "comment": "SPL f-string double-quoted: f\"...\"",
                    "name": "string.quoted.double.fstring.spl",
                    "begin": "[fF]\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "match": "\\{(@[a-zA-Z_][a-zA-Z0-9_]*)\\}",
                            "captures": { "1": { "name": "variable.other.spl" } }
                        },
                        { "name": "constant.character.escape.spl", "match": "\\\\." }
                    ]
                },
                {
                    "comment": "SPL f-string single-quoted: f'...'",
                    "name": "string.quoted.single.fstring.spl",
                    "begin": "[fF]'",
                    "end": "'",
                    "patterns": [
                        {
                            "match": "\\{(@[a-zA-Z_][a-zA-Z0-9_]*)\\}",
                            "captures": { "1": { "name": "variable.other.spl" } }
                        },
                        { "name": "constant.character.escape.spl", "match": "\\\\." }
                    ]
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "comment": "Triple double-quoted string",
                    "name": "string.quoted.triple.double.spl",
                    "begin": "\"\"\"",
                    "end": "\"\"\"",
                    "patterns": [
                        { "name": "constant.character.escape.spl", "match": "\\\\." }
                    ]
                },
                {
                    "comment": "Triple single-quoted string",
                    "name": "string.quoted.triple.single.spl",
                    "begin": "'''",
                    "end": "'''",
                    "patterns": [
                        { "name": "constant.character.escape.spl", "match": "\\\\." }
                    ]
                },
                {
                    "name": "string.quoted.double.spl",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        { "name": "constant.character.escape.spl", "match": "\\\\." }
                    ]
                },
                {
                    "name": "string.quoted.single.spl",
                    "begin": "'(?!')",
                    "end": "'",
                    "patterns": [
                        { "name": "constant.character.escape.spl", "match": "\\\\." }
                    ]
                }
            ]
        },
        "constants": {
            "patterns": [
                {
                    "name": "constant.language.spl",
                    "match": "(?i)\\b(TRUE|FALSE|NONE|NULL)\\b"
                }
            ]
        },
        "variables": {
            "patterns": [
                {
                    "comment": "SPL variable references: @var_name",
                    "name": "variable.other.spl",
                    "match": "@[a-zA-Z_][a-zA-Z0-9_]*"
                },
                {
                    "comment": "memory.key, context.field, and rag.query dotted access",
                    "match": "\\b(memory|context|rag)\\.([a-zA-Z_][a-zA-Z0-9_]*)",
                    "captures": {
                        "1": { "name": "support.variable.namespace.spl" },
                        "2": { "name": "variable.other.member.spl" }
                    }
                }
            ]
        },
        "exception_types": {
            "patterns": [
                {
                    "comment": "SPL built-in CamelCase exception type names",
                    "name": "support.type.exception.spl",
                    "match": "\\b(HallucinationDetected|RefusalToAnswer|ContextLengthExceeded|ModelOverloaded|ModelUnavailable|QualityBelowThreshold|MaxIterationsReached|BudgetExceeded|NodeUnavailable|GenerationError|SearchFailed|FileNotFound|ToolError|ValueError|TypeError|RuntimeError|TimeoutError)\\b"
                },
                {
                    "comment": "SPL exception category keywords",
                    "name": "support.type.exception.spl",
                    "match": "(?i)\\b(HALLUCINATION|REFUSAL|OVERFLOW|ITERATIONS|OTHERS)\\b"
                }
            ]
        },
        "types": {
            "patterns": [
                {
                    "comment": "SPL data types in INPUT/OUTPUT/RETURNS declarations",
                    "name": "support.type.spl",
                    "match": "(?i)\\b(TEXT|STRING|NUMBER|INT|INTEGER|FLOAT|BOOL|BOOLEAN|LIST|SET|MAP|MATRIX|VECTOR|INDEX|DOCUMENT|DICT|JSON|IMAGE|AUDIO|VIDEO|STORAGE|ANY)\\b"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "comment": "Top-level declaration keywords",
                    "name": "keyword.declaration.spl",
                    "match": "(?i)\\b(WORKFLOW|PROCEDURE|IMPORT|PROMPT)\\b"
                },
                {
                    "comment": "CREATE FUNCTION / CREATE PROCEDURE",
                    "match": "(?i)\\b(CREATE)\\s+(FUNCTION|PROCEDURE)\\b",
                    "captures": {
                        "1": { "name": "keyword.declaration.spl" },
                        "2": { "name": "keyword.declaration.spl" }
                    }
                },
                {
                    "comment": "Core workflow control-flow keywords",
                    "name": "keyword.control.flow.spl",
                    "match": "(?i)\\b(DO|END|EVALUATE|WHEN|THEN|OTHERWISE|ELSE|WHILE|CALL|PARALLEL|BEGIN|RAISE|RETRY|EXCEPTION|INTO|RETURN|FOR|BATCH)\\b"
                },
                {
                    "comment": "INPUT and OUTPUT parameter declarations",
                    "name": "keyword.declaration.parameter.spl",
                    "match": "(?i)\\b(INPUT|OUTPUT)\\b"
                },
                {
                    "comment": "GENERATE — core LLM invocation keyword",
                    "name": "keyword.other.generate.spl",
                    "match": "(?i)\\b(GENERATE|EXECUTE|EXPLAIN)\\b"
                },
                {
                    "comment": "RETURNS in CREATE FUNCTION signature",
                    "name": "keyword.declaration.spl",
                    "match": "(?i)\\bRETURNS\\b"
                },
                {
                    "comment": "AS keyword (used in RETURNS ... AS $$)",
                    "name": "keyword.other.spl",
                    "match": "(?i)\\bAS\\b"
                },
                {
                    "comment": "WITH keyword (used in RETURN ... WITH status=)",
                    "name": "keyword.other.spl",
                    "match": "(?i)\\bWITH\\b"
                },
                {
                    "comment": "LOGGING construct",
                    "name": "keyword.other.spl",
                    "match": "(?i)\\bLOGGING\\b"
                },
                {
                    "comment": "LEVEL <severity> after LOGGING",
                    "match": "(?i)\\b(LEVEL)\\s+(INFO|DEBUG|WARN|WARNING|ERROR|CRITICAL)\\b",
                    "captures": {
                        "1": { "name": "keyword.other.spl" },
                        "2": { "name": "support.constant.log-level.spl" }
                    }
                },
                {
                    "comment": "STORE RESULT IN memory.<key>",
                    "match": "(?i)\\b(STORE)\\s+(RESULT)\\s+(IN)\\b",
                    "captures": {
                        "1": { "name": "keyword.other.spl" },
                        "2": { "name": "keyword.other.spl" },
                        "3": { "name": "keyword.other.spl" }
                    }
                },
                {
                    "comment": "USING MODEL '<model>' — inline model override",
                    "begin": "(?i)\\b(USING)\\s+(MODEL)\\b",
                    "beginCaptures": {
                        "1": { "name": "keyword.other.spl" },
                        "2": { "name": "keyword.other.spl" }
                    },
                    "end": "(?i)(?=\\s*(;|WITH|CACHE|SELECT|GENERATE|STORE|$))",
                    "patterns": [
                        { "include": "#strings" },
                        {
                            "match": "\\b[a-zA-Z_][a-zA-Z0-9_.\\-]*\\b",
                            "name": "entity.name.type.model.spl"
                        }
                    ]
                },
                {
                    "comment": "WITH BUDGET <n> TOKENS",
                    "match": "(?i)\\b(WITH)\\s+(BUDGET)\\b",
                    "captures": {
                        "1": { "name": "keyword.other.spl" },
                        "2": { "name": "keyword.other.spl" }
                    }
                },
                {
                    "comment": "Query clause keywords",
                    "name": "keyword.control.query.spl",
                    "match": "(?i)\\b(SELECT|FROM|WHERE|ORDER\\s+BY|ASC|DESC|IN|AND|OR|NOT|LIMIT)\\b"
                },
                {
                    "comment": "Miscellaneous configuration keywords",
                    "name": "keyword.other.spl",
                    "match": "(?i)\\b(TOKENS|MODEL|CACHE|TEMPERATURE|FORMAT|PARAMS|BUDGET|SET|DEFAULT|TO|COMMIT|ROLLBACK|TRANSACTION|ON|ERROR|SECURITY|ACCOUNTING|CLASSIFICATION|LABELS)\\b"
                },
                {
                    "comment": "SPL 1.0 extended / materialized-view keywords",
                    "name": "keyword.other.spl",
                    "match": "(?i)\\b(AUTO_COMPRESS|COMPRESSION_STRATEGY|SCHEMA|VERSION|REFRESH|EVERY|MATERIALIZED|GRID|VRAM)\\b"
                }
            ]
        },
        "function_calls": {
            "patterns": [
                {
                    "comment": "Built-in LLM generation functions",
                    "match": "(?i)\\b(summarize|translate|classify|extract_entities|sentiment|answer|rewrite|generate_code|greeting|quality_judge|quality_check|truncate|system_role)(?=\\s*\\()",
                    "name": "support.function.builtin.spl"
                },
                {
                    "comment": "List operations",
                    "match": "(?i)\\b(list|list_get|list_length|list_append|list_concat|list_count|list_join|list_contains|get|append|count|join|trim_turns)(?=\\s*\\()",
                    "name": "support.function.builtin.spl"
                },
                {
                    "comment": "Map operations",
                    "match": "(?i)\\b(map|map_get|map_set|map_keys|map_values|map_merge|map_has|map_delete)(?=\\s*\\()",
                    "name": "support.function.builtin.spl"
                },
                {
                    "comment": "Type conversion functions",
                    "match": "(?i)\\b(to_int|to_float|to_text|to_bool|len|len_val)(?=\\s*\\()",
                    "name": "support.function.builtin.spl"
                },
                {
                    "comment": "String functions",
                    "match": "(?i)\\b(upper|lower|trim|ltrim|rtrim|length|substr|replace|concat|instr|lpad|rpad|split_part|reverse)(?=\\s*\\()",
                    "name": "support.function.builtin.spl"
                },
                {
                    "comment": "Pattern matching functions",
                    "match": "(?i)\\b(like|startswith|endswith|contains|regexp_match)(?=\\s*\\()",
                    "name": "support.function.builtin.spl"
                },
                {
                    "comment": "Numeric functions",
                    "match": "(?i)\\b(abs_val|round_val|ceil_val|floor_val|mod_val|power_val|sqrt_val|sign_val|clamp)(?=\\s*\\()",
                    "name": "support.function.builtin.spl"
                },
                {
                    "comment": "Conditional and null-handling functions",
                    "match": "(?i)\\b(coalesce|nullif|iif|isnull|nvl|isblank)(?=\\s*\\()",
                    "name": "support.function.builtin.spl"
                },
                {
                    "comment": "Text aggregate functions",
                    "match": "(?i)\\b(word_count|char_count|line_count)(?=\\s*\\()",
                    "name": "support.function.builtin.spl"
                },
                {
                    "comment": "JSON functions",
                    "match": "(?i)\\b(json_get|json_set|json_keys|json_length|json_pretty)(?=\\s*\\()",
                    "name": "support.function.builtin.spl"
                },
                {
                    "comment": "Date and time functions",
                    "match": "(?i)\\b(now_iso|date_format_val|date_diff_days)(?=\\s*\\()",
                    "name": "support.function.builtin.spl"
                },
                {
                    "comment": "Hashing functions",
                    "match": "(?i)\\b(md5_hash|sha256_hash)(?=\\s*\\()",
                    "name": "support.function.builtin.spl"
                },
                {
                    "comment": "Agentic / network tool functions",
                    "match": "(?i)\\b(web_search|search_web|http_get|run_python)(?=\\s*\\()",
                    "name": "support.function.tool.spl"
                },
                {
                    "comment": "File I/O tool functions",
                    "match": "(?i)\\b(write_file|read_file|file_exists|make_dir|path_join)(?=\\s*\\()",
                    "name": "support.function.tool.spl"
                },
                {
                    "comment": "RAG / vector-store tool functions",
                    "match": "(?i)\\b(chunk_documents|embed_documents|embed_query|create_faiss_index|search_index|retrieve_document)(?=\\s*\\()",
                    "name": "support.function.tool.spl"
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.spl",
                    "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "comment": "String concatenation operator ||",
                    "name": "keyword.operator.concatenation.spl",
                    "match": "\\|\\|"
                },
                {
                    "comment": "SPL variable assignment :=",
                    "name": "keyword.operator.assignment.spl",
                    "match": ":="
                },
                {
                    "comment": "Comparison operators",
                    "name": "keyword.operator.comparison.spl",
                    "match": "(>=|<=|!=|<>|=|>|<)"
                },
                {
                    "comment": "Arithmetic operators",
                    "name": "keyword.operator.arithmetic.spl",
                    "match": "[+\\-*/%]"
                },
                {
                    "comment": "Tilde — semantic similarity operator",
                    "name": "keyword.operator.semantic.spl",
                    "match": "~"
                },
                {
                    "comment": "Statement terminator",
                    "name": "punctuation.terminator.statement.spl",
                    "match": ";"
                },
                {
                    "comment": "Colon separator",
                    "name": "punctuation.separator.colon.spl",
                    "match": ":"
                }
            ]
        }
    }
}
